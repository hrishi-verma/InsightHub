# Copy to .env.local (git-ignored). Public values only: everything NEXT_PUBLIC_* ends up in the browser.
# The backend API. Baked in at build time; production must be https.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Fake contract-shaped data with no backend. `next dev` only; production builds refuse it.
# NEXT_PUBLIC_USE_MOCKS=true
