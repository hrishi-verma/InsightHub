# InsightHub backend config. Copy to backend/.env (git-ignored) and fill in.
# The server validates all of this at startup and refuses to start if anything is missing or unsafe.

# production | development | test
NODE_ENV=development
PORT=8000

# Set LOG_LEVEL=silent to turn off logs (used by tests).

# How many reverse proxies sit in front of the API (1-9), or their addresses
# (e.g. "loopback" or "10.0.0.0/8"). "false" = no proxy. "true" is refused because it lets
# clients fake their IP and dodge rate limits.
TRUST_PROXY=false

# Postgres: either DATABASE_URL, or all of DB_HOST / DB_NAME / DB_USER / DB_PASSWORD (DB_PORT defaults to 5432).
# DATABASE_URL=postgres://user:password@host:5432/insighthub
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insighthub
DB_USER=postgres
DB_PASSWORD=

# Kafka brokers, comma-separated host:port
KAFKA_BROKER=localhost:9093

# Origins allowed to use the dashboard API with cookies. Comma-separated exact origins,
# no "*", https only in production.
DASHBOARD_ORIGINS=http://localhost:3000

# Legacy /api/logs only. At least 32 characters. Leave empty to switch the legacy API off (503).
# Generate with: openssl rand -base64 32
SERVICE_TOKEN=
# Legacy Kafka topic (default "logs")
# KAFKA_TOPIC=logs
