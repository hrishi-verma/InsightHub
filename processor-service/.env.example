# Processor service config. Copy to .env (git-ignored) for local runs.
# The service validates everything at startup and refuses to start on missing/invalid values.

# --- Kafka (required) ---
# Comma-separated host:port list.
KAFKA_BROKER=localhost:9093
# KAFKA_CLIENT_ID=insighthub-processor
# ERROR_EVENTS_TOPIC=error-events
# ERROR_EVENTS_GROUP=error-processors
# LEGACY_LOGS=on                     # also run the legacy `logs` consumer (group log-processors)
# PROCESSOR_CONCURRENCY=3            # partitions processed in parallel (1-32)
# MAX_MESSAGE_BYTES=65536            # bigger messages are skipped

# --- Postgres (DB_HOST and DB_PASSWORD required, no defaults) ---
DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=insighthub
# DB_USER=postgres
DB_PASSWORD=
# DB_SSL=off                         # off | require (verifies the server certificate)
# DB_POOL_MAX=10

# --- Health and metrics (GET /health, GET /metrics) ---
# NO AUTH. Must never be published to the internet. Loopback by default, so it is unreachable
# from outside the container unless an operator changes HEALTH_HOST on purpose.
# HEALTH_PORT=9100                   # 1-65535
# HEALTH_HOST=127.0.0.1

# --- Alert rules (contract §3 defaults) ---
# ALERT_SPIKE_MIN_COUNT=10
# ALERT_SPIKE_MULTIPLIER=5
# ALERT_SPIKE_WINDOW_MINUTES=5
# ALERT_SPIKE_BASELINE_HOURS=24
# ALERT_SPIKE_COOLDOWN_MINUTES=60

# --- ML (shadow only: stored, never used for alerts) ---
# ML_SHADOW=off                      # on | off
# ML_ENGINE_URL=http://localhost:5000  # required when ML_SHADOW=on; also used by the legacy pipeline

# --- Dead-letter topic ---
# Messages that are skipped (invalid or permanently failing) get a METADATA-ONLY record here
# (reason, partition, offset, size). Never the message content. Best effort: a failure is logged.
# DLQ=on                             # on | off
# DLQ_TOPIC=error-events-dlq

# --- Alert notifications (every channel is OFF unless configured) ---
# Sent after the alert is stored. At most NOTIFY_MAX_PER_HOUR per channel per rolling hour.
# Content: alert kind, project id, issue title (cut to 200 chars) and a dashboard link. No stack, URL path or tags.
# NOTIFY_MAX_PER_HOUR=20
# DASHBOARD_URL=https://dashboard.example.com   # https (http only for localhost); adds a link to each message
# Webhook (Slack/Discord-compatible/Teams incoming webhook). The URL is a secret: never logged.
# https only (http only for localhost). Redirects are refused.
# NOTIFY_WEBHOOK_URL=
# Email through SMTP. SMTP_HOST needs NOTIFY_EMAIL_FROM and NOTIFY_EMAIL_TO, or the service refuses to start.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=                         # SMTP_USER and SMTP_PASSWORD go together
# SMTP_PASSWORD=
# SMTP_SECURE=off                    # on = TLS from the start; off = STARTTLS is required (except for localhost)
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_TO=                   # comma-separated, max 10

# --- Tests only ---
# TEST_DB_NAME=insighthub_test_processor
